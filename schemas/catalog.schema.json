{
  "$id": "catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The open credit card dataset (github.com/lalit10/card-data): earn rates, fees, credits, signup bonuses. Synced into data/ by tools/sync-catalog.sh. Reference data \u2014 the user's own cards live in the portfolio file.",
  "properties": {
    "card_count": {
      "minimum": 0,
      "type": "integer"
    },
    "cards": {
      "items": {
        "properties": {
          "annual_fee_usd": {
            "minimum": 0,
            "type": "number"
          },
          "availability": {
            "enum": [
              "active",
              "discontinued"
            ],
            "type": "string"
          },
          "base_rate": {
            "type": [
              "number",
              "null"
            ]
          },
          "benefits": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpp_floor": {
            "description": "Cents per point, conservative",
            "type": [
              "number",
              "null"
            ]
          },
          "cpp_optimistic": {
            "description": "Cents per point, realistic upside",
            "type": [
              "number",
              "null"
            ]
          },
          "credits": {
            "items": {
              "properties": {
                "amount_usd": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "category": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "expires": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "period": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "requires_enrollment": {
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "currency_program": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency_type": {
            "enum": [
              "cash",
              "points",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "earn": {
            "items": {
              "properties": {
                "cap_period": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cap_usd": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "key": {
                  "type": "string"
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "portal_only": {
                  "type": "boolean"
                },
                "rate": {
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "category",
                    "merchant"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type",
                "key",
                "rate"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "foreign_transaction_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "issuer": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "network": {
            "type": [
              "string",
              "null"
            ]
          },
          "signup_bonus": {
            "properties": {
              "cash_usd": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "months": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "points": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "spend_usd": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ]
          },
          "verified_date": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "issuer",
          "annual_fee_usd",
          "earn"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "fetched_at": {
      "format": "date-time",
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_license": {
      "type": "string"
    },
    "source_ref": {
      "description": "Upstream commit SHA, when the catalog is generated from a pinned upstream source. Omitted for natively-curated catalogs.",
      "type": "string"
    },
    "valuations": {
      "additionalProperties": {
        "properties": {
          "floor_cpp": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "optimistic_cpp": {
            "type": "number"
          }
        },
        "type": "object"
      },
      "type": "object"
    }
  },
  "required": [
    "source",
    "fetched_at",
    "card_count",
    "cards"
  ],
  "title": "Card catalog",
  "type": "object"
}
